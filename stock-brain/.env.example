PORT=8787
HOST=127.0.0.1
BRAIN_DB_PATH=./data/stock-brain.db

# Knowledge inbox watched by the scheduler (DeepSeek Harness drops reviewed md/txt here)
BRAIN_KNOWLEDGE_INBOX=./data/knowledge-inbox
# Transcript directory auto-watched for new whisper outputs (optional)
BRAIN_TRANSCRIPT_DIR=
# Knowledge mirror for agent consumption (knowledge.json / knowledge.md / strategies.json)
BRAIN_EXPORT_DIR=./data/exports

# AI defaults; may also be configured in the UI
# DeepSeek: https://api.deepseek.com/v1  model: deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
