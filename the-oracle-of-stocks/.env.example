PORT=8787
HOST=127.0.0.1
GUSHEN_ALLOW_REMOTE=false
GUSHEN_ALLOW_INSECURE_HTTP=false
GUSHEN_TRUST_PROXY=false
GUSHEN_COOKIE_SECURE=false

# Personal single-node storage
GUSHEN_DB_PATH=./data/gushen.db
GUSHEN_BACKUP_DIR=./data/backups
GUSHEN_BACKUP_RETAIN=14
GUSHEN_RETENTION_DAYS=365
GUSHEN_DATABASE_BUSY_TIMEOUT_MS=5000
GUSHEN_DATABASE_WAL_AUTOCHECKPOINT_PAGES=1000

# Reproducible backtest artifacts
GUSHEN_BACKTEST_ARTIFACT_DIR=./data/backtest-artifacts
GUSHEN_BACKTEST_ARTIFACT_PERSISTENT_STORAGE=true
GUSHEN_BACKTEST_ARTIFACT_MAX_OBJECT_MB=64
GUSHEN_BACKTEST_ARTIFACT_MIN_FREE_GB=2
GUSHEN_BACKTEST_JOB_MAX_WORKERS=1
GUSHEN_BACKTEST_JOB_POLL_SECONDS=2
GUSHEN_BACKTEST_JOB_HEARTBEAT_SECONDS=10
GUSHEN_BACKTEST_JOB_CLAIM_TTL_MINUTES=5
GUSHEN_BACKTEST_JOB_MAX_RECOVERIES=3
GUSHEN_WORK_QUEUE_MAX_RECOVERIES=3

# AI defaults; may also be configured in the UI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Real-money execution remains disabled.
# Only configure a broker adapter for SANDBOX testing.
GUSHEN_BROKER_ADAPTER_ENV=SANDBOX
GUSHEN_BROKER_ADAPTER_ID=
GUSHEN_BROKER_ADAPTER_NAME=
GUSHEN_BROKER_ADAPTER_URL=
GUSHEN_BROKER_ADAPTER_TOKEN=
GUSHEN_BROKER_ADAPTER_ORDER_CAPABILITY=false
